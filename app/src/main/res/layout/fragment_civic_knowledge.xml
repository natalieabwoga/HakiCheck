<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/window_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_3xl">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/knowledge_header"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3sp"
            android:text="@string/knowledge_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <!-- Featured Guide Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFeaturedGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/radius_lg"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner_featured"
                android:orientation="vertical"
                android:padding="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#33FFFFFF"
                        android:fontFamily="sans-serif-bold"
                        android:paddingHorizontal="@dimen/spacing_sm"
                        android:paddingVertical="@dimen/spacing_2xs"
                        android:text="@string/knowledge_featured_badge"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_micro" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="01"
                        android:textColor="#66FFFFFF"
                        android:textSize="22sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:fontFamily="sans-serif-black"
                    android:text="@string/knowledge_featured_title"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3sp"
                    android:text="@string/knowledge_featured_desc"
                    android:textColor="#E2E8F0"
                    android:textSize="@dimen/text_body_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStartLearning"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:backgroundTint="@color/white"
                    android:fontFamily="sans-serif-bold"
                    android:text="@string/knowledge_featured_cta"
                    android:textColor="@color/primary_green"
                    app:cornerRadius="@dimen/radius_sm"
                    app:elevation="0dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Categories Section Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2xl"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.08"
            android:text="@string/knowledge_categories_header"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_micro" />

        <!-- Civic Topics RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCivicTopics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:nestedScrollingEnabled="false"
            tools:itemCount="4"
            tools:listitem="@layout/item_civic_card" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/surface_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg">

        <!-- Topic Icon Container -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip_sample">

            <ImageView
                android:id="@+id/ivTopicIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_library_books"
                app:tint="@color/primary_green" />
        </FrameLayout>

        <!-- Topic Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTopicTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-bold"
                    android:text="Elections 101"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_title_small" />

                <TextView
                    android:id="@+id/tvTopicLegalBasis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_sample"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="@dimen/spacing_sm"
                    android:paddingVertical="@dimen/spacing_2xs"
                    android:text="Article 38"
                    android:textColor="@color/primary_green"
                    android:textSize="@dimen/text_micro" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTopicDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2sp"
                android:text="How elections work, from voter registration to polling day counting."
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body_small" />

        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="@dimen/spacing_sm"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_forward"
            app:tint="@color/text_tertiary" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

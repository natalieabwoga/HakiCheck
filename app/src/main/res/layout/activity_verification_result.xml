<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    tools:context=".presentation.ui.verify.VerificationResultActivity">

    <!-- Top Action Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/appbar_background"
        app:elevation="1dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/resultToolbar"
            style="@style/Widget.HakiCheck.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/result_title">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnCopyResult"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/result_action_copy"
                    android:padding="8dp"
                    android:src="@drawable/ic_copy"
                    app:tint="@color/text_primary" />

                <ImageView
                    android:id="@+id/btnSaveResult"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/result_action_save"
                    android:padding="8dp"
                    android:src="@drawable/ic_bookmark"
                    app:tint="@color/text_primary" />

                <ImageView
                    android:id="@+id/btnShareResult"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/result_action_share"
                    android:padding="8dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/text_primary" />

            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_4xl">

            <!-- Verdict Card Container -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVerdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/verdict_false_border"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <!-- Topline: Badge + Timestamp -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvVerdictBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_verdict_false"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.05"
                            android:paddingHorizontal="@dimen/spacing_md"
                            android:paddingVertical="@dimen/spacing_xs"
                            android:text="@string/verdict_false"
                            android:textColor="@color/verdict_false_text"
                            android:textSize="@dimen/text_caption" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvCheckedTimestamp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:text="Checked just now"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_micro" />
                    </LinearLayout>

                    <!-- Analyzed Claim Quote -->
                    <TextView
                        android:id="@+id/tvClaimLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.06"
                        android:text="@string/result_analyzed_claim"
                        android:textColor="@color/text_tertiary"
                        android:textSize="@dimen/text_micro" />

                    <TextView
                        android:id="@+id/tvClaimText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_2xs"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingExtra="3sp"
                        android:text="“Kenyan citizens must pay Ksh 500 fee to register as a voter in 2027.”"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/spacing_md"
                        android:background="@color/divider_line" />

                    <!-- Grounded Summary Header -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_hakicheck_logo" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_xs"
                            android:fontFamily="sans-serif-bold"
                            android:text="@string/result_summary_header"
                            android:textColor="@color/primary_green"
                            android:textSize="@dimen/text_body_small" />
                    </LinearLayout>

                    <!-- Summary Body -->
                    <TextView
                        android:id="@+id/tvSummaryBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="4sp"
                        android:text="This claim is completely false. Kenyan citizens are not charged to register as voters; both the Constitution and IEBC’s statutory operational guidance protect free access to voter registration."
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Evidence Trail Section (Hidden when no citations exist, e.g. non-civic input) -->
            <LinearLayout
                android:id="@+id/layoutEvidenceSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2xl"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:letterSpacing="0.08"
                            android:text="GROUNDED CITATIONS"
                            android:textColor="@color/primary_green"
                            android:textSize="@dimen/text_micro" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="@string/result_evidence_header"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_title" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvEvidenceCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_sample"
                        android:fontFamily="sans-serif-medium"
                        android:paddingHorizontal="@dimen/spacing_md"
                        android:paddingVertical="@dimen/spacing_2xs"
                        android:text="2 legal extracts"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_micro" />
                </LinearLayout>

                <!-- Evidence Sources RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvEvidenceSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_evidence_source" />

            </LinearLayout>

            <!-- AI Confidence & Transparency Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/surface_variant"
                app:cardCornerRadius="@dimen/radius_md"
                app:cardElevation="0dp"
                app:strokeColor="@color/divider_line"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_md">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_info"
                        app:tint="@color/primary_green" />

                    <TextView
                        android:id="@+id/tvConfidenceBadge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_sm"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="Confidence: 98% • Grounded in Constitution &amp; Statute"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Disclaimer Notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2sp"
                android:text="@string/result_disclaimer"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_micro" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

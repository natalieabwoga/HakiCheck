<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_sm"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/radius_lg"
    app:cardElevation="0dp"
    app:strokeColor="@color/surface_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_lg">

        <!-- Topline: Verdict Badge + Viral Count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTrendingBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_verdict_false"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_2xs"
                android:text="@string/verdict_false"
                android:textColor="@color/verdict_false_text"
                android:textSize="@dimen/text_micro" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvViralCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="4.2k reports"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_micro" />
        </LinearLayout>

        <!-- Claim Title -->
        <TextView
            android:id="@+id/tvTrendingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:fontFamily="sans-serif-bold"
            android:text="IEBC charging Ksh 500 voter registration fee"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title_small" />

        <!-- Summary -->
        <TextView
            android:id="@+id/tvTrendingSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3sp"
            android:text="Voter registration in Kenya is guaranteed free of charge under Article 38(3) and Section 5 of Elections Act."
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_small" />

        <!-- Footer: Action Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-bold"
                android:text="Inspect Citations &amp; Evidence"
                android:textColor="@color/primary_green"
                android:textSize="@dimen/text_caption" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/primary_green" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

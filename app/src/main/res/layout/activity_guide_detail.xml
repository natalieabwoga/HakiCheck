<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    tools:context=".presentation.ui.knowledge.GuideDetailActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/appbar_background"
        app:elevation="1dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/guideToolbar"
            style="@style/Widget.HakiCheck.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="Civic Educational Guide" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_lg"
            android:paddingTop="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_4xl">

            <!-- Badges Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGuideCitation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_sample"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_2xs"
                    android:text="Article 38"
                    android:textColor="@color/primary_green"
                    android:textSize="@dimen/text_micro" />

                <TextView
                    android:id="@+id/tvGuideReadTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:fontFamily="sans-serif"
                    android:text="• 5 min read"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <!-- Guide Title -->
            <TextView
                android:id="@+id/tvGuideTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:fontFamily="sans-serif-black"
                android:lineSpacingExtra="4sp"
                android:text="Your Constitutional Right to Vote"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_headline" />

            <TextView
                android:id="@+id/tvGuideSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="3sp"
                android:text="Understand voter eligibility, registration, and protections under Article 38 of the Constitution."
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <!-- Key Takeaways Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeColor="@color/surface_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.08"
                        android:text="KEY TAKEAWAYS"
                        android:textColor="@color/primary_green"
                        android:textSize="@dimen/text_micro" />

                    <TextView
                        android:id="@+id/tvKeyTakeaways"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="5sp"
                        android:text="• Voter registration is 100% free of charge nationwide.\n• National ID or Passport is the only required ID.\n• Your vote is completely secret under Article 86.\n• Employers must permit employees reasonable time off to vote."
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body_small" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Guide Detailed Body Text -->
            <TextView
                android:id="@+id/tvGuideContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="6sp"
                android:text="Guide content loading…"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

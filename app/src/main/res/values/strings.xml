    <!-- Verify Screen -->
    <string name="verify_title">Check a Civic Claim</string>
    <string name="verify_subtitle">Cross-reference social media claims against the Kenyan Constitution, IEBC gazettes, and statutory election records.</string>
    <string name="verify_input_hint">Paste or type a claim, quote, or viral WhatsApp message…</string>
    <string name="verify_input_helper">Text claims only • 10 to 600 characters</string>

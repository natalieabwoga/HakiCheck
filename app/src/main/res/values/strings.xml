    <!-- Verdict Labels (5-Tier Fact-Checking Taxonomy) -->
    <string name="verdict_false">VERIFIED FALSE</string>
    <string name="verdict_true">VERIFIED TRUE</string>
    <string name="verdict_mostly_true">MOSTLY TRUE</string>
    <string name="verdict_misleading">MISLEADING</string>
    <string name="verdict_unverified">UNVERIFIED / INSUFFICIENT DATA</string>
    <string name="verdict_civic_info">CIVIC INFORMATION</string>

    <!-- Verdict Descriptions -->
    <string name="verdict_desc_false">The claim directly contradicts established constitutional provisions or official statutory records.</string>
    <string name="verdict_desc_true">The claim is completely substantiated by authoritative Kenyan legal and civic records.</string>
    <string name="verdict_desc_mostly_true">The core claim is accurate, though minor context or nuances are missing.</string>
    <string name="verdict_desc_misleading">The claim contains elements of truth but conveys a distorted, exaggerated, or false impression.</string>
    <string name="verdict_desc_unverified">Current Kenyan constitutional and electoral archives do not contain enough verified evidence to substantiate or refute this claim.</string>
    <string name="verdict_desc_civic_info">Authoritative civic guidance and answers directly retrieved from Kenyan constitutional and statutory records.</string>

